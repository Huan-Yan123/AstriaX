{
  "name": "mxbot-launcher",
  "productName": "AstriaX",
  "version": "1.0.2",
  "description": "AstriaX —— NapCat + AstrBot 多开管理器",
  "license": "MIT",
  "author": "梦见月下汐",
  "main": "out/main/index.js",
  "type": "commonjs",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev:setup": "node scripts/setup-dev.cjs",
    "dev:doctor": "node scripts/doctor.cjs",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "check": "pnpm run dev:doctor && pnpm build && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:ui": "vitest run tests/ui",
    "test:stress": "vitest run --mode stress",
    "test:integration": "vitest run --mode integration",
    "test:all": "vitest run --mode all",
    "check:release": "node scripts/full-check.cjs",
    "selfcheck": "node scripts/self-check.cjs",
    "dist:dir": "electron-vite build && node --use-system-ca node_modules/electron-builder/cli.js --win --x64 --dir --publish never",
    "dist:win": "electron-vite build && node --use-system-ca node_modules/electron-builder/cli.js --win --x64 --publish never",
    "dist": "electron-vite build && node --use-system-ca node_modules/electron-builder/cli.js --publish never",
    "dist:both": "node scripts/build-both-versions.cjs",
    "dist:3": "node scripts/build-three.cjs",
    "publish:gh": "node scripts/publish-github.cjs"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.5.0",
    "electron": "43.8.3",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vite": "6.4.4",
    "vitest": "4.1.12",
    "vue-tsc": "^2.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  }
}
