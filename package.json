{
  "name": "astriax",
  "productName": "AstriaX",
  "version": "1.0.2",
  "description": "AstriaX —— NapCat + AstrBot 多开管理器",
  "license": "MIT",
  "author": "梦见月下汐",
  "type": "module",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/tauri.ps1 dev",
    "dev:web": "vite --config vite.config.ts",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/tauri.ps1 build --no-bundle",
    "build:web": "vite build --config vite.config.ts",
    "check:rust": "powershell -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 check --workspace",
    "check:clippy": "powershell -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 clippy --workspace --all-targets -- -D warnings",
    "test:desktop": "powershell -ExecutionPolicy Bypass -File scripts/tauri-smoke.ps1",
    "test:installer": "powershell -ExecutionPolicy Bypass -File scripts/test-installer.ps1",
    "test:rust": "powershell -ExecutionPolicy Bypass -File scripts/with-msvc.ps1 test -p astriax-core -- --test-threads=1",
    "check:web": "vue-tsc --noEmit -p tsconfig.json",
    "test": "pnpm check:web && pnpm test:web && pnpm test:rust",
    "test:watch": "vitest",
    "dist": "powershell -ExecutionPolicy Bypass -File scripts/tauri.ps1 build",
    "test:web": "vitest run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "vue": "^3.5.42"
  }
}
